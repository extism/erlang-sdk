{minimum_otp_vsn, "29"}.

{erl_opts, [debug_info, warn_unused_vars, warn_shadow_vars, warn_export_vars, {i, "include"}]}.

{deps, [
    {wasm, "0.9.1", {pkg, erlang_wasm}},
    {thoas, "1.2.1"}
]}.

{project_plugins, []}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.

{ct_opts, [
    {dir, "test"},
    {logdir, "_build/test/logs"},
    {readable, true}
]}.

{hex, [{doc, #{provider => edoc}}]}.

{ex_doc, [
    {source_url, <<"https://github.com/extism/erlang-sdk">>},
    {extras, [<<"README.md">>]},
    {main, <<"readme">>}
]}.
